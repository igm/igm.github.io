                        {
                          "type": "text",
                          "id": "wbxO8",
                          "name": "Lead",
                          "fill": "$muted",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "After years of practicing test-driven, behaviour-driven and, in darker times, schedule-driven development, I have distilled everything I learned into a single unified methodology.",
                          "lineHeight": 1.65,
                          "fontFamily": "$font-body",
                          "fontSize": 18,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "xfWUI",
                          "name": "Para 1",
                          "fill": "$text",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Coffee-Driven Development holds that the state of the system is a direct function of the engineer's caffeine blood level. Everything else — sprint length, story points, the shape of the retro board — is downstream of that one variable, and pretending otherwise is how teams end up shipping on a Friday.",
                          "lineHeight": 1.75,
                          "fontFamily": "$font-body",
                          "fontSize": 16,
                          "fontWeight": "normal"
                        },
